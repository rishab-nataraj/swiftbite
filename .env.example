# Copy this file to `.env` before running docker compose.
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env

# ----- PostgreSQL -----
POSTGRES_USER=swiftbite
POSTGRES_PASSWORD=swiftbite
POSTGRES_DB=swiftbite

# ----- Backend -----
# Change this to a long random string before any real deployment.
SECRET_KEY=dev-secret-change-me
DATABASE_URL=postgresql://swiftbite:swiftbite@db:5432/swiftbite

# ----- Frontend -----
VITE_API_TARGET=http://backend:8000
