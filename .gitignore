# ---------------------------------------------------------------
# SwiftBite .gitignore
# ---------------------------------------------------------------

# ----- Environment & secrets -----
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# ----- Python / FastAPI backend -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib60/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml
*.cover
.tox/

# ----- Node / React frontend -----
node_modules/
dist/
dist-ssr/
build/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.eslintcache

# ----- Databases -----
*.sqlite3
*.db
pgdata/
postgres-data/
*.dump

# ----- Docker -----
docker-compose.override.yml

# ----- IDEs & editors -----
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ----- OS files -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ----- Logs & temp -----
logs/
*.log
tmp/
temp/
