ndArrow=open;endSize=12;dashed=1;strokeWidth=1.3;strokeColor=#475569;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0.35;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="v11" target="v21"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e52" value="«reads»" style="html=1;endArrow=open;endSize=12;dashed=1;strokeWidth=1.3;strokeColor=#475569;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v15" target="v23"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v53" value="All «entity» classes extend SQLAlchemy &lt;i&gt;Base&lt;/i&gt; and map 1:1 to PostgreSQL tables.&lt;br&gt;Composition (◆): deleting the whole cascades to its parts (cascade=&amp;quot;all, delete-orphan&amp;quot;).&lt;br&gt;Order prices are recomputed by OrderRouter.place_order — the client total is never trusted." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBEB;strokeColor=#F59E0B;fontSize=12;align=left;spacingLeft=12;fontColor=#16181D;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="1450" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>