<mxfile host="app.diagrams.net" agent="SwiftBite"><diagram name="DFD Level 0 - Context Diagram" id="d25"><mxGraphModel dx="1440" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="860" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v1" value="SwiftBite — DFD Level 0 (Context Diagram)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=26;fontColor=#16181D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1360" height="40" as="geometry" /></mxCell><mxCell id="v2" value="The whole system as one process, with the external entities that exchange data with it" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1360" height="24" as="geometry" /></mxCell><mxCell id="v3" value="👤&lt;br&gt;Customer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=17;fontStyle=1;fontColor=#16181D;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="200" height="110" as="geometry" /></mxCell><mxCell id="v4" value="🍳&lt;br&gt;Restaurant Partner" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;fontSize=17;fontStyle=1;fontColor=#16181D;" vertex="1" parent="1"><mxGeometry x="1200" y="330" width="200" height="110" as="geometry" /></mxCell><mxCell id="v5" value="&lt;b&gt;0&lt;/b&gt;&lt;hr style='border-color:#0F766E;width:60%'&gt;&lt;b&gt;SwiftBite&lt;/b&gt;&lt;br&gt;Food Ordering &amp;amp;&lt;br&gt;Delivery System" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#CCFBF1;strokeColor=#0F766E;strokeWidth=3;fontSize=18;fontColor=#16181D;" vertex="1" parent="1"><mxGeometry x="570" y="235" width="300" height="300" as="geometry" /></mxCell><mxCell id="e6" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16181D;exitX=1;exitY=0.25;entryX=0.02;entryY=0.42;" edge="1" parent="1" source="v3" target="v5"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16181D;exitX=0.02;exitY=0.6;entryX=1;entryY=0.75;dashed=1;" edge="1" parent="1" source="v5" target="v3"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v8" value="• Registration &amp;amp; login details&lt;br&gt;• Search keyword / cuisine filter&lt;br&gt;• Cart items, delivery address,&lt;br&gt;&amp;nbsp;&amp;nbsp;payment method&lt;br&gt;• Order cancellation request" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=13;fontColor=#16181D;" vertex="1" parent="1"><mxGeometry x="250" y="230" width="300" height="120" as="geometry" /></mxCell><mxCell id="v9" value="• JWT access token &amp;amp; profile&lt;br&gt;• Restaurant list &amp;amp; menus&lt;br&gt;• Bill summary &amp;amp; order confirmation&lt;br&gt;• Live order status&lt;br&gt;• Order history / error messages" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#16181D;" vertex="1" parent="1"><mxGeometry x="250" y="432" width="300" height="120" as="geometry" /></mxCell><mxCell id="e10" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16181D;exitX=0;exitY=0.25;entryX=0.98;entryY=0.42;" edge="1" parent="1" source="v4" target="v5"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#16181D;exitX=0.98;exitY=0.6;entryX=0;entryY=0.75;dashed=1;" edge="1" parent="1" source="v5" target="v4"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v12" value="• Order status updates&lt;br&gt;&amp;nbsp;&amp;nbsp;(CONFIRMED → DELIVERED)&lt;br&gt;• Dish availability (sold out)&lt;br&gt;• Restaurant open / closed" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=13;fontColor=#16181D;" vertex="1" parent="1"><mxGeometry x="890" y="250" width="300" height="100" as="geometry" /></mxCell><mxCell id="v13" value="• New order details&lt;br&gt;&amp;nbsp;&amp;nbsp;(items, quantities, address)&lt;br&gt;• Current order status" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#16181D;" vertex="1" parent="1"><mxGeometry x="890" y="432" width="300" height="100" as="geometry" /></mxCell><mxCell id="v14" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="1360" height="170" as="geometry" /></mxCell><mxCell id="v15" value="LEGEND (Yourdon–DeMarco notation)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#475569;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="400" height="26" as="geometry" /></mxCell><mxCell id="v16" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=17;fontStyle=1;fontColor=#16181D;" vertex="1" parent="1"><mxGeometry x="70" y="700" width="70" height="40" as="geometry" /></mxCell><mxCell id="v17" value="External entity" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#16181D;" vertex="1" parent="1"><mxGeometry x="150" y="700" width="160" height="40" as="geometry" /></mxCell><mxCell id="v18" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#CCFBF1;strokeColor=#0F766E;strokeWidth=2;fontSize=18;fontColor=#16181D;" vertex="1" parent="1"><mxGeometry x="340" y="690" width="60" height="60" as="geometry" /></mxCell><mxCell id="v19" value="Process" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#16181D;" vertex="1" parent="1"><mxGeometry x="410" y="700" width="120" height="40" as="geometry" /></mxCell><mxCell id="e20" value="" st